# SG Max-Temp Prediction Market Dashboard
# Copy this file to .env and fill in your values

# data.gov.sg API key (optional but recommended for higher rate limits)
# Get one at: https://data.gov.sg/user/login
DATA_GOV_API_KEY=your_api_key_here

# Server configuration
PORT=8000
HOST=0.0.0.0

# Trading configuration (optional overrides)
# BANKROLL_USD=1000.0
# MAX_STAKE_PER_POSITION_USD=1.0
# DAILY_LOSS_LIMIT_PCT=0.03

# ── Trade notifications ──────────────────────────────────────────────
# Webhook URL to receive trade signals (ENTER/EXIT/STOP/TAKE_PROFIT).
# Leave unset to disable. Works with Discord, Slack, Ntfy, or any generic
# JSON POST endpoint. Example channels:
#   Discord: https://discord.com/api/webhooks/<id>/<token>
#   Slack:   https://hooks.slack.com/services/T00000000/B00000000/XXXX
#   Ntfy:    https://ntfy.sh/mytopic
TRADE_WEBHOOK_URL=

# Email channel: deliver trade signals to one or more recipients (comma-separated).
# Set NOTIFY_EMAIL_RECIPIENTS in Render's dashboard (or your local .env) to the
# address you want alerts in — e.g. lokesh960077152@gmail.com.
# ⚠ Do NOT set your Gmail login password here — generate an App Password instead:
#   https://myaccount.google.com/apppasswords  (needs 2-Step Verification on)
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<your gmail>
NOTIFY_EMAIL_RECIPIENTS=lokesh960077152@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to true if you use SMTP_PORT=465 (SSL). Leave false for 587 (STARTTLS).
SMTP_USE_SSL=false
# Optional: override the From header (defaults to SMTP_USER).
# NOTIFY_EMAIL_FROM=Sentinel <no-reply@localhost>

# ── Rate limiting (optional overrides) ───────────────────────────────
# Requests per second for most /api endpoints (default 5). /api/prices and
# /api/health are exempt — the dashboard polls them constantly.
# RATE_LIMIT_DEFAULT_RPS=5
# Requests per minute for the heavy /api/dashboard endpoint (default 60).
# RATE_LIMIT_DASHBOARD_RPM=60
