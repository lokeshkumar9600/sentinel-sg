# SG Max-Temp Prediction Market Dashboard
# Copy this file to .env and fill in your values

# data.gov.sg API key (optional but recommended for higher rate limits)
# Get one at: https://data.gov.sg/user/login
DATA_GOV_API_KEY=your_api_key_here

# Server configuration
PORT=8000
HOST=0.0.0.0

# Trading configuration (optional overrides)
# BANKROLL_USD=1000.0
# MAX_STAKE_PER_POSITION_USD=1.0
# DAILY_LOSS_LIMIT_PCT=0.03
